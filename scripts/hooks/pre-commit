#!/usr/bin/env bash
# Pre-commit hook — secret detection, then a harness gate scoped to this commit.
#
# Install: ./scripts/setup.sh  (or copy to .git/hooks/pre-commit and chmod +x)
#
# Design note: this hook enforces only what THIS commit touches. A whole-repo
# gate here punishes you for pre-existing issues you did not introduce, which
# trains everyone to reach for --no-verify — and a bypassed gate enforces
# nothing. Repo-wide health belongs in CI and /harness-check. The per-commit
# question is narrower and answerable: "is what I am committing right now OK?"

set -e

echo "Running pre-commit checks..."

STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
[ -z "$STAGED" ] && exit 0

# ── Secret detection ───────────────────────────────────────────────────────
# A leaked credential is the one mistake a later commit cannot undo — once it is
# in history it must be treated as compromised and rotated. Cheapest possible
# place to catch it.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --pre-commit --staged --no-banner -q; then
    echo ""
    echo "✗ Secrets detected in staged changes. Remove them before committing."
    exit 1
  fi
  echo "  ✓ No secrets detected"
else
  echo "  ⚠ gitleaks not installed — skipping secret detection"
  echo "    Install: https://github.com/gitleaks/gitleaks#installing"
fi

# ── Formatters / fixers ────────────────────────────────────────────────────
# Add your per-file fixers here — they should operate on the staged set only,
# then re-stage what they change. Examples:
#
#   npx lint-staged
#   pre-commit run --files $STAGED
#
# Keep whole-tree formatting out of this hook; it makes commits touch files the
# author never opened, which makes review harder and blame useless.

# ── Harness gate, scoped to the staged set ─────────────────────────────────
# Run the full validator but fail only on findings that name a staged file.
if echo "$STAGED" | grep -qE '\.md$'; then
  LINT_OUTPUT=$(bash scripts/lint-docs.sh --quiet 2>&1 || true)
  RELEVANT=""
  for f in $STAGED; do
    MATCHES=$(printf '%s\n' "$LINT_OUTPUT" | grep -F "$f" | grep -E '^[[:space:]]*✗' || true)
    if [ -n "$MATCHES" ]; then
      RELEVANT="$RELEVANT
$MATCHES"
    fi
  done
  if [ -n "$RELEVANT" ]; then
    echo ""
    echo "✗ Harness lint failures in staged file(s):"
    echo "$RELEVANT"
    echo ""
    echo "Fix and re-stage. Run 'bash scripts/lint-docs.sh' for the full report."
    exit 1
  fi
  echo "  ✓ Harness lint clean for staged docs"
fi

echo "✓ Pre-commit checks passed"
