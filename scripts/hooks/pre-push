#!/usr/bin/env bash
# Pre-push hook — the aggregate gate, plus a doc-drift warning.
#
# Install: ./scripts/setup.sh  (or copy to .git/hooks/pre-push and chmod +x)
#
# Push is the last free checkpoint. Past it, a failure costs a CI round-trip and
# shows up in a reviewer's inbox instead of your terminal.

set -e

echo "Running pre-push checks..."

# ── Aggregate gate ─────────────────────────────────────────────────────────
# Everything in scripts/check.sh: harness lint plus whatever gates you added.
if [ -f scripts/check.sh ]; then
  if ! bash scripts/check.sh; then
    echo ""
    echo "✗ scripts/check.sh failed — fix before pushing."
    echo "  Genuinely need to push anyway (spike branch, WIP backup)?"
    echo "  git push --no-verify"
    exit 1
  fi
fi

# ── Doc-drift warning ──────────────────────────────────────────────────────
# A file-diff heuristic, not a language model: does this push change code
# without touching any doc? Costs nothing to run and catches the most common
# form of drift — a behavior change nobody wrote down.
#
# Warning, not a block, because the false-positive rate is real: plenty of code
# changes genuinely need no doc update. Flip `exit 0` to `exit 1` below if your
# project wants it enforced.
CHANGED=$(git diff --name-only '@{push}..' 2>/dev/null || git diff --name-only HEAD~1 2>/dev/null || true)

if [ -n "$CHANGED" ]; then
  # Adjust the source pattern to match your layout.
  SOURCE_CHANGED=$(echo "$CHANGED" | grep -E '^(src|lib|app|internal|cmd)/' || true)
  DOCS_CHANGED=$(echo "$CHANGED" | grep -E '(^docs/|^ARCHITECTURE\.md$|^AGENTS\.md$|^README\.md$)' || true)

  if [ -n "$SOURCE_CHANGED" ] && [ -z "$DOCS_CHANGED" ]; then
    echo ""
    echo "  ⚠ Source changed with no doc updates in this push:"
    echo "$SOURCE_CHANGED" | sed 's/^/      /'
    echo ""
    echo "    If this changes architecture, an API contract, a data model, or a"
    echo "    convention, update the relevant doc. If it genuinely doesn't,"
    echo "    proceed — this is a prompt, not a gate."
  fi
fi

echo "✓ Pre-push checks passed"
